results/ccx/
results/ccx_smoke/
*.eig
*.frd
*.sta
__pycache__/
*.pyc
~$*
# LS-DYNA run products: keep only the input decks (main.k mesh.k loads.k run.bat); evidence summaries are in lsdyna/run_evidence_*
lsdyna/*/*
!lsdyna/*/main.k
!lsdyna/*/mesh.k
!lsdyna/*/loads.k
!lsdyna/*/run.bat
!lsdyna/run_evidence_*/
!lsdyna/manifest.json
!lsdyna/static_check.txt
!lsdyna/run_evidence_*/*
# version B (solid soil) decks: same rule
lsdyna_solid/*/*
!lsdyna_solid/*/main.k
!lsdyna_solid/*/mesh.k
!lsdyna_solid/*/loads.k
!lsdyna_solid/*/run.bat
!lsdyna_solid/manifest.json
results/ccx_solidcheck/
# large sensitivity runs of version B: only their band levels (results/tables/solid_sensitivity_bands.csv) are tracked
results/ccx_*_c.npz
